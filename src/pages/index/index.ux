<template>
  <div class="page">
    <div class="settings-page" if="{{ settingsOpen }}">
      <text class="settings-title">{{ $t('settings.title') }}</text>
      <text class="settings-value">{{ $t('settings.fontSize', { size: fontSize }) }}</text>
      <slider
        class="font-slider"
        min="24"
        max="48"
        step="2"
        value="{{ fontSize }}"
        onchange="handleFontSizeChange"
      ></slider>
      <text class="font-preview" style="font-size: {{ fontSize }}px;">{{ $t('settings.preview') }}</text>
      <input class="back-button" type="button" value="{{ $t('common.back') }}" onclick="closeSettings" />
    </div>

    <scroll class="main-page" scroll-y="true" bounces="true" if="{{ !settingsOpen }}">
      <text class="header" if="{{ !connected }}">Data Sync</text>
      <div class="{{ compactHeader ? 'status-spacer compact' : 'status-spacer' }}"></div>
      <div class="status-row">
        <input
          class="round-button back-button-small"
          type="button"
          if="{{ connected && reading }}"
          value="‹"
          onclick="returnToInitial"
        />
        <text class="status">{{ currentTime }}</text>
        <input
          class="round-button settings-button"
          type="button"
          value="Aa"
          onclick="openSettings"
        />
      </div>
      <input
        class="detail-toggle"
        type="button"
        if="{{ !connected }}"
        value="{{ showDetail ? $t('diagnostics.hide') : $t('diagnostics.show') }}"
        onclick="toggleDetail"
      />
      <div class="detail-panel" if="{{ !connected && showDetail }}">
        <text class="detail-text" for="{{ detailLines }}">{{ $item }}</text>
      </div>
      <scroll
        id="contentScroll"
        class="content-scroll"
        scroll-y="true"
        bounces="true"
        onscroll="handleContentScroll"
      >
        <div class="content">
          <div class="item">
            <text
              class="empty-text"
              if="{{ !reading && historyItems.length === 0 }}"
              style="font-size: {{ fontSize }}px;"
            >{{ $t('empty') }}</text>
            <div class="history-panel" if="{{ !reading && historyItems.length > 0 }}">
              <text class="history-title">{{ $t('history.title') }}</text>
              <text class="history-status" if="{{ historyStatus }}">{{ historyStatus }}</text>
              <input
                class="history-item"
                type="button"
                for="{{ historyItems }}"
                value="{{ $item.displayName }}"
                onclick="openHistory($item)"
              />
            </div>
          </div>
          <div class="item message" if="{{ reading }}" onclick="handleReadingTap">
            <div class="page-item" for="{{ pageItems }}">
              <image class="reading-image" if="{{ $item.type === 'image' && $item.src }}" src="{{ $item.src }}" style="width: {{ $item.width }}px; height: {{ $item.height }}px;" onerror="imageLoadFailed($idx)" />
              <text class="image-alt" if="{{ $item.type === 'image' && !$item.src }}">{{ $item.alt }}</text>
              <text class="message-text" if="{{ $item.type === 'text' }}" style="font-size: {{ fontSize }}px;">{{ $item.content }}</text>
            </div>
          </div>
          <div class="item nav-block" if="{{ reading }}">
            <div class="actions-row">
              <input
                class="action-btn prev"
                type="button"
                value="{{ $t('navigation.previous') }}"
                onclick="handlePrevious"
              />
              <input
                class="action-btn next"
                type="button"
                value="{{ $t('navigation.next') }}"
                onclick="handleNext"
              />
            </div>
            <input
              class="skip-btn"
              type="button"
              if="{{ canSkipImages }}"
              value="{{ $t('navigation.skipImages') }}"
              onclick="handleSkipImages"
            />
          </div>
        </div>
      </scroll>
    </scroll>
  </div>
</template>

<script>
import interconnect from "@system.interconnect"
import prompt from "@system.prompt"
import { base64ToBytes, decodePayload } from "./codec"
import { currentTime, truncateName } from "./format"
import { describeApkStatus as describeStatus, describeCode as describeErrorCode, describeDiagnosis as describeDiagnosisStatus, isApkConnected } from "./status"
import file from "@system.file"
import app from "@system.app"
import device from "@system.device"

export default {
  private: {
    conn: null,
    displayText: "",
    reading: false,
    canSkipImages: false,
    pendingSkipImages: false,
    incomingSeq: 1,
    pageItems: [],
    imageFiles: {},
    pendingPage: null,
    pendingPageTimer: null,
    lastUnknown: "",
    connected: false,
    protocolReady: false,
    protocolRequested: false,
    protocolVersion: "1.1",
    statusText: "",
    showDetail: false,
    detailLines: [],
    settingsOpen: false,
    fontSize: 32,
    historyItems: [],
    historyStatus: "",
    historyRequested: false,
    readingName: "",
    compactHeader: false,
    imageCacheDir: "",
    imageUris: [],
    pendingImage: null,
    currentTime: "00:00",
    clockTimer: null
  },

  onReady() {
    const info = app.getInfo()
    this.imageCacheDir = `internal://cache/${info.packageName}/caches/img`
    this.prepareImageCache()
    this.statusText = this.$t("status.disconnected")
    this.readingName = this.$t("reading")
    this.updateClock()
    this.clockTimer = setInterval(() => this.updateClock(), 1000)
    this.setupInterconnect()
  },

  prepareImageCache() {
    file.access({
      uri: this.imageCacheDir,
      success: () => this.clearImageCache(),
      fail: () => file.mkdir({ uri: this.imageCacheDir, recursive: true })
    })
  },

  clearImageCache(done) {
    this.imageUris = []
    this.imageFiles = {}
    file.rmdir({
      uri: this.imageCacheDir,
      recursive: true,
      complete: () => file.mkdir({
        uri: this.imageCacheDir,
        recursive: true,
        complete: () => { if (done) done() }
      })
    })
  },

  onShow() {
    this.updateClock()
    if (!this.clockTimer) {
      this.clockTimer = setInterval(() => this.updateClock(), 1000)
    }
    if (!this.conn) {
      this.setupInterconnect()
    } else {
      this.refreshStatus()
    }
  },

  onDestroy() {
    if (this.clockTimer) {
      clearInterval(this.clockTimer)
      this.clockTimer = null
    }
  },

  updateClock() {
    this.currentTime = currentTime(new Date())
  },

  setupInterconnect() {
    const conn = interconnect.instance()
    this.conn = conn
    this.addDetail(this.$t("diagnostics.initializing"))

    conn.onopen = (data) => {
      const reconnected = data && data.isReconnected ? this.$t("diagnostics.reconnected") : ""
      console.log(`[interconnect] onopen${reconnected}`)
      this.connected = true
      this.protocolReady = false
      this.protocolRequested = false
      this.showDetail = false
      this.statusText = this.$t("status.connected")
      this.addDetail(`onopen${reconnected}`)
      this.negotiateProtocol()
      this.scheduleHistoryRequest()
    }

    conn.onclose = (data) => {
      const code = data && data.code
      console.log(`[interconnect] onclose code=${code} data=${data && data.data}`)
      this.connected = false
      this.protocolReady = false
      this.protocolRequested = false
      this.historyRequested = false
      this.statusText = this.$t("status.closed")
      this.addDetail(`onclose code=${code} (${this.describeCode(code)})`)
    }

    conn.onerror = (data) => {
      const code = data && data.code
      console.log(`[interconnect] onerror code=${code} data=${data && data.data}`)
      this.connected = false
      this.historyRequested = false
      this.statusText = this.$t("status.connectionError")
      this.addDetail(`onerror code=${code} (${this.describeCode(code)})`)
    }

    conn.onmessage = (res) => {
      this.handleIncomingMessage(res)
    }

    this.refreshStatus()
    this.runDiagnosis()
  },

  refreshStatus() {
    if (!this.conn) return

    let status = null
    try {
      if (typeof this.conn.getApkStatus === "function") {
        status = this.conn.getApkStatus()
        this.addDetail(`getApkStatus=${status} (${this.describeApkStatus(status)})`)
      }
    } catch (e) {
      this.addDetail(`getApkStatus error: ${e && e.message ? e.message : e}`)
    }

    if (status != null) {
      this.connected = this.isApkConnected(status)
      if (this.connected) this.showDetail = false
      if (this.connected) this.scheduleHistoryRequest()
      this.statusText = this.describeApkStatus(status)
      return
    }

    this.conn.getReadyState({
      success: (res) => {
        const s = res && res.status
        this.connected = s === 1
        if (this.connected) this.showDetail = false
        if (this.connected) this.scheduleHistoryRequest()
      this.statusText = this.connected ? this.$t("status.connected") : this.$t("status.disconnected")
        this.addDetail(`getReadyState status=${s}`)
      },
      fail: (res, code) => {
        this.connected = false
        this.statusText = this.$t("status.disconnected")
        this.addDetail(`getReadyState fail code=${code} (${this.describeCode(code)})`)
      }
    })
  },

  describeApkStatus(status) {
    return describeStatus(status, (key, args) => this.$t(key, args))
  },

  isApkConnected,

  handleIncomingMessage(res) {
    const data = res && res.data !== undefined ? res.data : res
    let raw = null
    try {
      raw = decodePayload(data)
    } catch (e) {
      this.addDetail(`decode bytes error: ${e && e.message ? e.message : e}`)
    }

    if (raw == null) {
      this.noteUnknown(data)
      this.addDetail(this.$t("diagnostics.unrecognizedData"))
      return
    }

    let msg = null
    try {
      msg = JSON.parse(raw)
    } catch (e) {
      msg = null
    }

    if (msg && msg.type === "image_chunk") {
      this.receiveImageChunk(msg)
      return
    }
    console.log(`[interconnect] onmessage: ${raw.length > 200 ? raw.slice(0, 200) + "..." : raw}`)

    if (msg && msg.type === "protocol") {
      this.handleProtocolMessage(msg)
    } else if (msg && (msg.type === "page" || msg.type === "text")) {
      this.handlePageMessage(msg)
    } else if (msg && msg.type === "history_list" && Array.isArray(msg.items)) {
      this.historyItems = msg.items.map((item) => ({
        id: String(item.id || ""),
        displayName: truncateName(String(item.name || ""))
      }))
      this.historyStatus = ""
    } else if (msg && msg.type === "history_error") {
      this.historyStatus = ""
      this.displayText = this.$t("history.readFailed", { message: msg.message || this.$t("error.unknown") })
      this.pageItems = [{ type: "text", content: this.displayText }]
      this.reading = true
      this.scrollContentToTop()
    } else if (msg && msg.type === "not_supported") {
      this.showToast(msg.message || this.$t("navigation.previousUnsupported"))
    } else if (msg == null) {
      this.noteUnknown(data)
      this.addDetail(this.$t("diagnostics.unknownMessageFormat"))
    }
  },

  noteUnknown(data) {
    let head = ""
    try {
      if (typeof data === "string") {
        head = Array.from(data.slice(0, 8)).map((c) => c.charCodeAt(0)).join(",")
      } else if (data && typeof data === "object") {
        head = Array.from({ length: 8 }, (_, i) => data[i]).join(",")
      }
    } catch (e) {
      head = "?"
    }
    const ctor = data && data.constructor ? data.constructor.name : ""
    const len = data && (data.length !== undefined ? data.length : data.byteLength)
    this.lastUnknown = `${typeof data}/${ctor} len=${len} [${head}]`
    this.addDetail(`unknown: ${this.lastUnknown}`)
  },

  // Image chunks arrive as base64 (the bridge only delivers strings). Each chunk is
  // appended to the image file with native base64 decoding, so no per-byte JS runs
  // and the whole image is never held in memory.
  receiveImageChunk(msg) {
    if (typeof msg.data !== "string") return
    let target = this.imageFiles[msg.id]
    if (!target || msg.offset === 0) {
      target = {
        uri: `${this.imageCacheDir}/img-${this.incomingSeq}-${msg.id}.jpg`,
        total: msg.total, written: 0, error: null, queue: [], busy: false
      }
      this.imageFiles[msg.id] = target
    }
    target.queue.push(msg)
    this.drainImageWrites(target)
  },

  drainImageWrites(target) {
    if (target.busy || target.error != null || target.queue.length === 0) return
    target.busy = true
    const chunk = target.queue.shift()
    // String writes (writeText) turn bytes >= 128 into U+FFFD on the watch, so decode
    // to a Uint8Array and write it as a buffer.
    file.writeArrayBuffer({
      uri: target.uri,
      buffer: base64ToBytes(chunk.data),
      append: chunk.offset > 0,
      success: () => {
        target.written = chunk.offset + chunk.length
        target.busy = false
        this.drainImageWrites(target)
        this.receivePendingPage()
      },
      fail: (data, code) => {
        target.error = code
        target.queue = []
        target.busy = false
        this.receivePendingPage()
      }
    })
  },

  handleProtocolMessage(msg) {
    this.protocolReady = msg.compatible === true && msg.version === this.protocolVersion
    if (!this.protocolReady) this.showToast(this.$t("protocol.incompatible"))
  },

  negotiateProtocol() {
    if (this.protocolRequested) return
    this.protocolRequested = true
    // Report screen geometry so the phone can size images; layout math stays on the phone.
    const send = (info) => {
      const extra = { version: this.protocolVersion }
      if (info && info.screenWidth) {
        extra.screenWidth = info.screenWidth
        extra.screenHeight = info.screenHeight
        extra.screenShape = info.screenShape
        // .page padding (30px) and .message padding (16px) on both sides.
        extra.contentWidth = info.screenWidth - 2 * (30 + 16)
      }
      this.sendAction("protocol", extra)
    }
    device.getInfo({ success: send, fail: () => send(null) })
  },

  handlePageMessage(msg) {
    if (msg.type === "page" && Array.isArray(msg.items)) {
      this.pendingPage = msg.items
      this.pendingSkipImages = msg.skipImages === true
      if (this.pendingPageTimer) clearTimeout(this.pendingPageTimer)
      this.pendingPageTimer = setTimeout(() => this.receivePendingPage(true), 5000)
      this.receivePendingPage()
      return
    }
    if (msg.type === "text" && typeof msg.content === "string") {
      this.historyStatus = ""
      this.pageItems = [{ type: "text", content: msg.content }]
      this.displayText = msg.content
      this.canSkipImages = false
      this.reading = true
      this.scrollContentToTop()
      this.sendAction("received")
    }
  },

  imageLoadFailed(index) {
    const item = this.pageItems[index]
    if (!item) return
    const show = (detail) => {
      const alt = `${this.$t("image.decodeFailed")} ${detail}`
      this.addDetail(alt)
      this.pageItems.splice(index, 1, { type: "image", alt: alt })
    }
    // Diagnose the written file: actual vs expected size, and leading bytes (JPEG = ff d8 ff).
    file.readArrayBuffer({
      uri: item.src,
      success: (data) => {
        const bytes = data.buffer
        const head = Array.from(bytes.subarray(0, 8)).map((b) => (b < 16 ? "0" : "") + b.toString(16)).join(" ")
        show(`(${bytes.length}/${item.total}B, ${head})`)
      },
      fail: (data, code) => show(`(read ${code})`)
    })
  },

  receivePendingPage(timedOut) {
    if (!this.pendingPage) return
    const done = (item) => {
      const target = this.imageFiles[item.id]
      return target && (target.error != null || target.written >= target.total)
    }
    const ready = this.pendingPage.every((item) => item.type !== "image" || item.available === false || done(item))
    if (!ready && !timedOut) return
    const items = this.pendingPage.map((item) => this.resolvePageItem(item))
    if (this.pendingPageTimer) clearTimeout(this.pendingPageTimer)
    this.pendingPageTimer = null
    this.pendingPage = null
    this.receivePage(items)
  },

  resolvePageItem(item) {
    if (item.type !== "image") return item
    if (item.available === false) return { type: "image", alt: this.$t("image.conversionFailed") }
    const target = this.imageFiles[item.id]
    if (target && target.error != null) {
      return { type: "image", alt: this.$t("image.writeFailed", { code: target.error, bytes: target.total }) }
    }
    if (!target || target.written < target.total) {
      const missing = this.$t("image.incomplete", {
        received: target ? target.written : 0,
        total: target ? target.total : "?",
        lastUnknown: this.lastUnknown || this.$t("diagnostics.none")
      })
      this.addDetail(missing)
      return { type: "image", alt: missing }
    }
    // Width/height are computed by the phone; fall back to the old fixed box.
    return { type: "image", src: target.uri, total: target.total, alt: item.alt || "", width: item.width || 300, height: item.height || 260 }
  },

  receivePage(items) {
    this.pageItems = items.filter((item) => item.type !== "text" || item.content)
    this.displayText = items.filter((item) => item.type === "text").map((item) => item.content).join("")
    this.canSkipImages = this.pendingSkipImages
    this.reading = true
    this.scrollContentToTop()
    this.sendAction("received")
    // The new page is shown; remove the previous page's image files and start a
    // new file sequence so <image> never shows a cached image from an old URI.
    const stale = this.imageUris || []
    this.imageUris = items.filter((item) => item.src).map((item) => item.src)
    stale.forEach((uri) => file.delete({ uri: uri }))
    this.imageFiles = {}
    this.incomingSeq++
  },

  openSettings() {
    this.settingsOpen = true
  },

  closeSettings() {
    this.settingsOpen = false
  },

  handleFontSizeChange(e) {
    this.fontSize = e.progress
  },

  scrollContentToTop() {
    this.compactHeader = false
    setTimeout(() => {
      const scroll = this.$element("contentScroll")
      if (scroll) {
        scroll.scrollTo({ top: 0, behavior: "instant" })
      }
    }, 0)
  },

  handleReadingTap(e) {
    if (!this.reading || !e) return
    if (e.clientY <= 120) {
      this.compactHeader = false
      return
    }
    if (e.clientY < 320) return
    this.compactHeader = true
    const scroll = this.$element("contentScroll")
    if (scroll) {
      scroll.scrollBy({ top: 300, behavior: "smooth" })
    }
  },

  handleContentScroll(e) {
    if (!this.reading) return
    this.compactHeader = !!e && e.scrollY > 8
  },

  returnToInitial() {
    this.reading = false
    this.canSkipImages = false
    this.pageItems = []
    this.displayText = ""
    this.readingName = this.$t("reading")
    this.compactHeader = false
    this.historyStatus = ""
    // Leaving the current file: image names (img-<seq>-<id>) can repeat across files and
    // app launches, so drop its images now or the next file could show them.
    this.clearImageCache()
    this.sendAction("reset")
    this.requestHistory()
    this.scrollContentToTop()
  },

  handlePrevious() {
    this.sendAction("previous")
  },

  handleNext() {
    this.sendAction("next")
  },

  handleSkipImages() {
    this.canSkipImages = false
    this.sendAction("skip_images")
  },

  showToast(message) {
    prompt.showToast({ message: message, duration: 2 })
  },

  requestHistory() {
    this.sendAction("history_list")
  },

  scheduleHistoryRequest() {
    if (this.historyRequested) return
    this.historyRequested = true
    setTimeout(() => this.requestHistory(), 500)
  },

  openHistory(item) {
    if (!item || !item.id) return
    this.readingName = item.displayName
    this.historyStatus = this.$t("history.opening", { name: item.displayName })
    // Opening a file: image names are reused across files, so drop the previous file's
    // images first; send the request only after the folder is recreated, so the first
    // incoming image chunk cannot race with the deletion.
    this.clearImageCache(() => {
      this.sendAction("history_open", { id: item.id }, () => {
        this.historyStatus = this.$t("history.requestFailed")
      })
    })
  },

  toggleDetail() {
    this.showDetail = !this.showDetail
    if (this.showDetail) {
      this.addDetail(this.$t("diagnostics.starting"))
      this.runDiagnosis()
    }
  },

  addDetail(line) {
    let lines = this.detailLines.concat(line)
    if (lines.length > 20) {
      lines = lines.slice(lines.length - 20)
    }
    this.detailLines = lines
  },

  runDiagnosis() {
    if (!this.conn) {
      this.addDetail(this.$t("diagnostics.noConnection"))
      return
    }
    this.addDetail(this.$t("diagnostics.running"))
    this.conn.diagnosis({
      timeout: 1500,
      success: (res) => {
        const status = res && res.status
        this.addDetail(`diagnosis status=${status} (${this.describeDiagnosis(status)})`)
      },
      fail: (res, code) => {
        this.addDetail(`diagnosis fail code=${code} (${this.describeCode(code)})`)
      }
    })
  },

  describeDiagnosis(status) {
    return describeDiagnosisStatus(status, (key, args) => this.$t(key, args))
  },

  describeCode(code) {
    return describeErrorCode(code, (key, args) => this.$t(key, args))
  },

  sendAction(action, extra, onFail) {
    if (!this.conn) {
      this.setupInterconnect()
    }
    const data = { type: "action", action: action }
    if (extra) {
      Object.keys(extra).forEach((key) => {
        data[key] = extra[key]
      })
    }
    this.conn.send({
      data: data,
      success: () => {
        console.log(`[interconnect] action "${action}" sent`)
      },
      fail: (res, code) => {
        console.log(`[interconnect] action "${action}" send fail code=${code} data=${res && res.data}`)
        this.addDetail(`send "${action}" fail code=${code} (${this.describeCode(code)})`)
        if (onFail) onFail(res, code)
      }
    })
  }
}
</script>

<style>
.page {
  flex: 1;
  flex-direction: column;
  padding: 30px;
  background-color: #000000;
}

.main-page,
.settings-page {
  width: 100%;
  flex-direction: column;
}

.main-page {
  height: 454px;
}

.settings-page {
  flex: 1;
}

.settings-title {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30px;
}

.settings-value,
.font-preview {
  text-align: center;
  margin-bottom: 20px;
}

.settings-value {
  font-size: 26px;
}

.font-slider {
  width: 100%;
  margin-bottom: 30px;
  padding-left: 0;
  padding-right: 0;
  selected-color: #0faeff;
}

.back-button {
  width: 100%;
  height: 70px;
  margin-top: 30px;
  border-radius: 35px;
  font-size: 26px;
  color: #ffffff;
  background-color: #666666;
}

.status-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20px;
}

.status-spacer {
  width: 100%;
  height: 27px;
}

.status-spacer.compact {
  height: 0;
}

.round-button {
  width: 54px;
  height: 54px;
  border-radius: 27px;
  font-size: 20px;
  color: #ffffff;
  text-align: center;
  background-color: transparent;
  border: 2px solid #888888;
}

.back-button-small {
  margin-left: 56px;
  font-size: 34px;
}

.settings-button {
  margin-right: 56px;
}

.content {
  width: 100%;
  flex-direction: column;
}

.content-scroll {
  width: 100%;
  height: 380px;
  flex-direction: column;
}

.header {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10px;
}

.status {
  flex: 1;
  font-size: 22px;
  text-align: center;
  color: #888888;
}

.detail-toggle {
  width: 100%;
  height: 60px;
  margin-bottom: 10px;
  border-radius: 30px;
  font-size: 24px;
  color: #ffffff;
  text-align: center;
  background-color: #666666;
}

.detail-panel {
  width: 100%;
  flex-direction: column;
  margin-bottom: 10px;
  padding: 16px;
  background-color: #1e1e1e;
  border-radius: 10px;
