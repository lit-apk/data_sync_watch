<template>
  <div class="page">
    <div class="settings-page" if="{{ settingsOpen }}">
      <text class="settings-title">字体设置</text>
      <text class="settings-value">字号：{{ fontSize }}</text>
      <slider
        class="font-slider"
        min="24"
        max="48"
        step="2"
        value="{{ fontSize }}"
        onchange="handleFontSizeChange"
      ></slider>
      <text class="font-preview" style="font-size: {{ fontSize }}px;">文字预览</text>
      <input class="back-button" type="button" value="返回" onclick="closeSettings" />
    </div>

    <scroll class="main-page" scroll-y="true" bounces="true" if="{{ !settingsOpen }}">
      <text class="header" if="{{ !connected }}">Data Sync</text>
      <div class="{{ compactHeader ? 'status-spacer compact' : 'status-spacer' }}"></div>
      <div class="status-row">
        <input
          class="round-button back-button-small"
          type="button"
          if="{{ connected && displayText }}"
          value="‹"
          onclick="returnToInitial"
        />
        <text class="status">{{ currentTime }}</text>
        <input
          class="round-button settings-button"
          type="button"
          value="Aa"
          onclick="openSettings"
        />
      </div>
      <input
        class="detail-toggle"
        type="button"
        if="{{ !connected }}"
        value="{{ showDetail ? '隐藏详情' : '诊断详情' }}"
        onclick="toggleDetail"
      />
      <div class="detail-panel" if="{{ !connected && showDetail }}">
        <text class="detail-text" for="{{ detailLines }}">{{ $item }}</text>
      </div>
      <scroll
        id="contentScroll"
        class="content-scroll"
        scroll-y="true"
        bounces="true"
        onscroll="handleContentScroll"
      >
        <div class="content">
          <div class="item">
            <text
              class="empty-text"
              if="{{ !displayText && historyItems.length === 0 }}"
              style="font-size: {{ fontSize }}px;"
            >{{ emptyText }}</text>
            <div class="history-panel" if="{{ !displayText && historyItems.length > 0 }}">
              <text class="history-title">阅读历史</text>
              <text class="history-status" if="{{ historyStatus }}">{{ historyStatus }}</text>
              <input
                class="history-item"
                type="button"
                for="{{ historyItems }}"
                value="{{ $item.displayName }}"
                onclick="openHistory($item)"
              />
            </div>
          </div>
          <div class="item message" onclick="handleReadingTap">
            <text class="message-text" style="font-size: {{ fontSize }}px;">{{ displayText }}</text>
          </div>
          <div class="item" if="{{ displayText }}">
            <div class="actions-row">
              <input
                class="action-btn prev"
                type="button"
                value="{{ previousLabel }}"
                onclick="handlePrevious"
              />
              <input
                class="action-btn next"
                type="button"
                value="{{ nextLabel }}"
                onclick="handleNext"
              />
            </div>
          </div>
        </div>
      </scroll>
    </scroll>
  </div>
</template>

<script>
import interconnect from "@system.interconnect"
import prompt from "@system.prompt"

export default {
  private: {
    conn: null,
    displayText: "",
    connected: false,
    statusText: "未连接",
    emptyText: "暂无消息，等待手机端发送…",
    previousLabel: "上一页",
    nextLabel: "下一段",
    showDetail: false,
    detailLines: [],
    settingsOpen: false,
    fontSize: 32,
    historyItems: [],
    historyStatus: "",
    historyRequested: false,
    readingName: "阅读内容",
    compactHeader: false,
    currentTime: "00:00",
    clockTimer: null
  },

  onReady() {
    this.updateClock()
    this.clockTimer = setInterval(() => this.updateClock(), 1000)
    this.setupInterconnect()
  },

  onShow() {
    this.updateClock()
    if (!this.clockTimer) {
      this.clockTimer = setInterval(() => this.updateClock(), 1000)
    }
    if (!this.conn) {
      this.setupInterconnect()
    } else {
      this.refreshStatus()
    }
  },

  onDestroy() {
    if (this.clockTimer) {
      clearInterval(this.clockTimer)
      this.clockTimer = null
    }
  },

  updateClock() {
    const now = new Date()
    const hours = String(now.getHours()).padStart(2, "0")
    const minutes = String(now.getMinutes()).padStart(2, "0")
    this.currentTime = `${hours}:${minutes}`
  },

  setupInterconnect() {
    const conn = interconnect.instance()
    this.conn = conn
    this.addDetail("初始化连接实例…")

    conn.onopen = (data) => {
      const reconnected = data && data.isReconnected ? " (重连)" : ""
      console.log(`[interconnect] onopen${reconnected}`)
      this.connected = true
      this.showDetail = false
      this.statusText = "已连接"
      this.addDetail(`onopen${reconnected}`)
      this.scheduleHistoryRequest()
    }

    conn.onclose = (data) => {
      const code = data && data.code
      console.log(`[interconnect] onclose code=${code} data=${data && data.data}`)
      this.connected = false
      this.historyRequested = false
      this.statusText = "已断开"
      this.addDetail(`onclose code=${code} (${this.describeCode(code)})`)
    }

    conn.onerror = (data) => {
      const code = data && data.code
      console.log(`[interconnect] onerror code=${code} data=${data && data.data}`)
      this.connected = false
      this.historyRequested = false
      this.statusText = "连接错误"
      this.addDetail(`onerror code=${code} (${this.describeCode(code)})`)
    }

    conn.onmessage = (res) => {
      this.handleIncomingMessage(res)
    }

    this.refreshStatus()
    this.runDiagnosis()
  },

  refreshStatus() {
    if (!this.conn) return

    let status = null
    try {
      if (typeof this.conn.getApkStatus === "function") {
        status = this.conn.getApkStatus()
        this.addDetail(`getApkStatus=${status} (${this.describeApkStatus(status)})`)
      }
    } catch (e) {
      this.addDetail(`getApkStatus error: ${e && e.message ? e.message : e}`)
    }

    if (status != null) {
      this.connected = this.isApkConnected(status)
      if (this.connected) this.showDetail = false
      if (this.connected) this.scheduleHistoryRequest()
      this.statusText = this.describeApkStatus(status)
      return
    }

    this.conn.getReadyState({
      success: (res) => {
        const s = res && res.status
        this.connected = s === 1
        if (this.connected) this.showDetail = false
        if (this.connected) this.scheduleHistoryRequest()
        this.statusText = this.connected ? "已连接" : "未连接"
        this.addDetail(`getReadyState status=${s}`)
      },
      fail: (res, code) => {
        this.connected = false
        this.statusText = "未连接"
        this.addDetail(`getReadyState fail code=${code} (${this.describeCode(code)})`)
      }
    })
  },

  describeApkStatus(status) {
    if (status == null) return "未知"
    const s = String(status).toUpperCase()
    if (s === "CONNECTED" || status === 0 || status === 1) return "已连接"
    if (s === "CONNECTING") return "连接中"
    if (s === "DISCONNECTED" || status === 2) return "未连接"
    if (s === "UNINSTALLED" || status === 1001) return "未连接(APP未安装)"
    if (status === 204) return "未连接(超时)"
    if (status === 1000) return "未连接(其他)"
    return `状态${status}`
  },

  isApkConnected(status) {
    const s = String(status).toUpperCase()
    return s === "CONNECTED" || status === 0 || status === 1
  },

  handleIncomingMessage(res) {
    const data = res && res.data !== undefined ? res.data : res
    const raw = this.decodePayload(data)

    if (raw == null) {
      this.addDetail("onmessage: 无法识别消息数据")
      return
    }

    console.log(`[interconnect] onmessage: ${raw}`)

    let msg = null
    try {
      msg = JSON.parse(raw)
    } catch (e) {
      msg = null
    }

    if (msg && msg.type === "text" && typeof msg.content === "string") {
      this.historyStatus = ""
      this.displayText = msg.content
      this.scrollContentToTop()
      this.sendAction("received")
    } else if (msg && msg.type === "history_list" && Array.isArray(msg.items)) {
      this.historyItems = msg.items.map((item) => ({
        id: String(item.id || ""),
        displayName: this.truncateName(String(item.name || ""))
      }))
      this.historyStatus = ""
    } else if (msg && msg.type === "history_error") {
      this.historyStatus = ""
      this.displayText = `读取失败：${msg.message || "未知错误"}`
      this.scrollContentToTop()
    } else if (msg && msg.type === "not_supported") {
      this.showToast(msg.message || "不支持上一页")
    } else {
      this.displayText = String(raw)
    }
  },

  decodePayload(data) {
    if (typeof data === "string") return data
    if (data === undefined || data === null) return null

    let bytes = null
    try {
      if (typeof ArrayBuffer !== "undefined" && data instanceof ArrayBuffer) {
        bytes = new Uint8Array(data)
      } else if (data.buffer && typeof data.byteLength === "number") {
        bytes = new Uint8Array(data.buffer, data.byteOffset || 0, data.byteLength)
      } else if (Array.isArray(data)) {
        bytes = data
      } else if (typeof data === "object") {
        if (typeof data.type === "string") return JSON.stringify(data)
        const keys = Object.keys(data).filter((key) => /^\d+$/.test(key))
        if (keys.length > 0) {
          keys.sort((a, b) => Number(a) - Number(b))
          bytes = keys.map((key) => data[key])
        }
      }
    } catch (e) {
      this.addDetail(`decode bytes error: ${e && e.message ? e.message : e}`)
    }

    if (bytes) return this.decodeUtf8(bytes)
    return typeof data === "object" ? JSON.stringify(data) : String(data)
  },

  decodeUtf8(bytes) {
    let text = ""
    for (let i = 0; i < bytes.length; i++) {
      const first = bytes[i] & 255
      if (first < 128) {
        text += String.fromCharCode(first)
      } else if (first < 224 && i + 1 < bytes.length) {
        text += String.fromCharCode(((first & 31) << 6) | (bytes[++i] & 63))
      } else if (first < 240 && i + 2 < bytes.length) {
        text += String.fromCharCode(
          ((first & 15) << 12) | ((bytes[++i] & 63) << 6) | (bytes[++i] & 63)
        )
      } else if (i + 3 < bytes.length) {
        let code =
          ((first & 7) << 18) |
          ((bytes[++i] & 63) << 12) |
          ((bytes[++i] & 63) << 6) |
          (bytes[++i] & 63)
        code -= 65536
        text += String.fromCharCode(55296 + (code >> 10), 56320 + (code & 1023))
      }
    }
    return text
  },

  openSettings() {
    this.settingsOpen = true
  },

  closeSettings() {
    this.settingsOpen = false
  },

  handleFontSizeChange(e) {
    this.fontSize = e.progress
  },

  scrollContentToTop() {
    this.compactHeader = false
    setTimeout(() => {
      const scroll = this.$element("contentScroll")
      if (scroll) {
        scroll.scrollTo({ top: 0, behavior: "instant" })
      }
    }, 0)
  },

  handleReadingTap(e) {
    if (!this.displayText || !e) return
    if (e.clientY <= 120) {
      this.compactHeader = false
      return
    }
    if (e.clientY < 320) return
    this.compactHeader = true
    const scroll = this.$element("contentScroll")
    if (scroll) {
      scroll.scrollBy({ top: 300, behavior: "smooth" })
    }
  },

  handleContentScroll(e) {
    if (!this.displayText) return
    this.compactHeader = !!e && e.scrollY > 8
  },

  returnToInitial() {
    this.displayText = ""
    this.readingName = "阅读内容"
    this.compactHeader = false
    this.historyStatus = ""
    this.sendAction("reset")
    this.requestHistory()
    this.scrollContentToTop()
  },

  handlePrevious() {
    this.sendAction("previous")
  },

  handleNext() {
    this.sendAction("next")
  },

  showToast(message) {
    prompt.showToast({ message: message, duration: 2 })
  },

  requestHistory() {
    this.sendAction("history_list")
  },

  scheduleHistoryRequest() {
    if (this.historyRequested) return
    this.historyRequested = true
    setTimeout(() => this.requestHistory(), 500)
  },

  openHistory(item) {
    if (!item || !item.id) return
    this.readingName = item.displayName
    this.historyStatus = `正在打开 ${item.displayName}…`
    this.sendAction("history_open", { id: item.id }, () => {
      this.historyStatus = "请求发送失败，请重试"
    })
  },

  truncateName(name) {
    const max = 8
    if (name.length <= max) return name
    return `${name.slice(0, max - 3)}...`
  },

  toggleDetail() {
    this.showDetail = !this.showDetail
    if (this.showDetail) {
      this.addDetail("展开详情，正在诊断…")
      this.runDiagnosis()
    }
  },

  addDetail(line) {
    let lines = this.detailLines.concat(line)
    if (lines.length > 20) {
      lines = lines.slice(lines.length - 20)
    }
    this.detailLines = lines
  },

  runDiagnosis() {
    if (!this.conn) {
      this.addDetail("diagnosis: 无连接实例")
      return
    }
    this.addDetail("diagnosis 进行中(timeout=1500ms)…")
    this.conn.diagnosis({
      timeout: 1500,
      success: (res) => {
        const status = res && res.status
        this.addDetail(`diagnosis status=${status} (${this.describeDiagnosis(status)})`)
      },
      fail: (res, code) => {
        this.addDetail(`diagnosis fail code=${code} (${this.describeCode(code)})`)
      }
    })
  },

  describeDiagnosis(status) {
    if (status === 0) return "已连接"
    if (status === 204) return "连接超时"
    if (status === 1001) return "手机APP未安装"
    if (status === 1000) return "其他错误"
    return "未知"
  },

  describeCode(code) {
    if (code === 1000) return "未知错误"
    if (code === 1001) return "手机APP未安装"
    if (code === 1006) return "连接断开"
    if (code === 204) return "连接超时"
    if (code === 202) return "参数错误"
    return "未知"
  },

  sendAction(action, extra, onFail) {
    if (!this.conn) {
      this.setupInterconnect()
    }
    const data = { type: "action", action: action }
    if (extra) {
      Object.keys(extra).forEach((key) => {
        data[key] = extra[key]
      })
    }
    this.conn.send({
      data: data,
      success: () => {
        console.log(`[interconnect] action "${action}" sent`)
      },
      fail: (res, code) => {
        console.log(`[interconnect] action "${action}" send fail code=${code} data=${res && res.data}`)
        this.addDetail(`send "${action}" fail code=${code} (${this.describeCode(code)})`)
        if (onFail) onFail(res, code)
      }
    })
  }
}
</script>

<style>
.page {
  flex: 1;
  flex-direction: column;
  padding: 30px;
  background-color: #000000;
}

.main-page,
.settings-page {
  width: 100%;
  flex-direction: column;
}

.main-page {
  height: 454px;
}

.settings-page {
  flex: 1;
}

.settings-title {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30px;
}

.settings-value,
.font-preview {
  text-align: center;
  margin-bottom: 20px;
}

.settings-value {
  font-size: 26px;
}

.font-slider {
  width: 100%;
  margin-bottom: 30px;
  padding-left: 0;
  padding-right: 0;
  selected-color: #0faeff;
}

.back-button {
  width: 100%;
  height: 70px;
  margin-top: 30px;
  border-radius: 35px;
  font-size: 26px;
  color: #ffffff;
  background-color: #666666;
}

.status-row {
  width: 100%;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20px;
}

.status-spacer {
  width: 100%;
  height: 27px;
}

.status-spacer.compact {
  height: 0;
}

.round-button {
  width: 54px;
  height: 54px;
  border-radius: 27px;
  font-size: 20px;
  color: #ffffff;
  text-align: center;
  background-color: transparent;
  border: 2px solid #888888;
}

.back-button-small {
  margin-left: 56px;
  font-size: 34px;
}

.settings-button {
  margin-right: 56px;
}

.content {
  width: 100%;
  flex-direction: column;
}

.content-scroll {
  width: 100%;
  height: 380px;
  flex-direction: column;
}

.header {
  font-size: 36px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10px;
}

.status {
  flex: 1;
  font-size: 22px;
  text-align: center;
  color: #888888;
}

.detail-toggle {
  width: 100%;
  height: 60px;
  margin-bottom: 10px;
  border-radius: 30px;
  font-size: 24px;
  color: #ffffff;
  text-align: center;
  background-color: #666666;
}

.detail-panel {
  width: 100%;
  flex-direction: column;
  margin-bottom: 10px;
  padding: 16px;
  background-color: #1e1e1e;
  border-radius: 10px;
}

.detail-text {
  font-size: 20px;
  color: #ffb84d;
  margin-bottom: 4px;
}

.item {
  width: 100%;
  justify-content: center;
}

.message {
  margin-bottom: 10px;
  padding: 16px;
  background-color: #1e1e1e;
  border-radius: 10px;
}

.message-text {
  color: #ffffff;
  width: 100%;
}

.empty-text {
  color: #888888;
  text-align: center;
}

.history-panel {
  width: 100%;
  flex-direction: column;
}

.history-title {
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 14px;
  color: #ffffff;
}

.history-status {
  width: 100%;
  font-size: 22px;
  color: #0faeff;
  margin-bottom: 10px;
}

.history-item {
  width: 100%;
  height: 64px;
  padding-left: 18px;
  padding-right: 18px;
  margin-bottom: 10px;
  align-items: center;
  text-align: left;
  font-size: 25px;
  color: #ffffff;
  background-color: #292929;
  border-radius: 16px;
}

.actions-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
}

.action-btn {
  width: 220px;
  height: 80px;
  border-radius: 40px;
  font-size: 28px;
  color: #ffffff;
  text-align: center;
}

.prev {
  background-color: #666666;
}

.next {
  background-color: #0faeff;
}
</style>
